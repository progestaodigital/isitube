{
  "name": "isitube",
  "version": "0.2.6",
  "description": "Inteligência competitiva e planejamento de conteúdo para criadores no YouTube",
  "private": true,
  "main": "out/main/index.js",
  "author": "Fabio Aleixo",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --config.npmRebuild=false",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "release:upload": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@distube/ytsr": "^2.0.4",
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.5.17",
    "ai": "^6.0.177",
    "clsx": "^2.1.1",
    "google-trends-api": "^4.9.2",
    "lucide-react": "^0.468.0",
    "node-machine-id": "^1.1.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.isi.isitube",
    "productName": "isiTube",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "prompts",
        "to": "prompts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "prisma/migrations",
        "to": "migrations",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "isiTube",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
