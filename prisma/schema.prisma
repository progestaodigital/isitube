// isiTube database schema
//
// All tables are sync-ready: UUID primary keys, created_at/updated_at,
// nullable synced_at + deleted_at for soft delete and future sync layer (v2+).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Generic key/value settings (theme, language, schedule preferences, etc).
model Setting {
  id        String    @id @default(uuid())
  key       String    @unique
  value     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("settings")
}

// Encrypted API credentials. Encrypted value never leaves main process.
model ApiCredential {
  id              String    @id @default(uuid())
  provider        String    @unique
  encryptedValue  Bytes?    @map("encrypted_value")
  status          String    @default("missing")
  lastValidatedAt DateTime? @map("last_validated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  syncedAt        DateTime? @map("synced_at")
  deletedAt       DateTime? @map("deleted_at")

  @@map("api_credentials")
}

// Audit/sync log: every mutation appends a row here.
model ChangeLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String   @map("entity_id")
  operation String
  payload   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, createdAt])
  @@map("change_log")
}

// Keyword research (Module 5)
model Keyword {
  id             String          @id @default(uuid())
  term           String          @unique
  lastSearchedAt DateTime?       @map("last_searched_at")
  searchCount    Int             @default(0) @map("search_count")
  searches       KeywordSearch[]
  // Cards do Kanban que apontam pra essa keyword (palavra-chave principal).
  kanbanCards    KanbanCard[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("keywords")
}

model KeywordSearch {
  id         String  @id @default(uuid())
  keywordId  String  @map("keyword_id")
  keyword    Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  result     String
  scoreValue Float?  @map("score_value")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([keywordId, createdAt])
  @@map("keyword_searches")
}

// Channel monitoring (Module 1)

model Channel {
  id              String    @id @default(uuid())
  youtubeId       String    @unique @map("youtube_id")
  title           String
  thumbnailUrl    String?   @map("thumbnail_url")
  // BigInt — canais grandes ultrapassam 2^31 (T-Series ~290M subs hoje,
  // MrBeast 90B+ total views). Era Int e quebrava o findMany inteiro.
  subscriberCount BigInt?   @map("subscriber_count")
  videoCount      Int?      @map("video_count")
  totalViewCount  BigInt?   @map("total_view_count")
  monitored       Boolean   @default(true)
  lastUpdatedAt   DateTime? @map("last_updated_at")

  videos     Video[]
  snapshots  ChannelSnapshot[]
  categories ChannelCategory[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("channels")
}

// User-defined categories ("nicho") for grouping channels. Many-to-many
// with channels via ChannelCategory.
model Category {
  id    String  @id @default(uuid())
  name  String  @unique
  color String? // hex (#RRGGBB), optional — UI picks a default if null

  channels ChannelCategory[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("categories")
}

model ChannelCategory {
  channelId  String   @map("channel_id")
  categoryId String   @map("category_id")
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([channelId, categoryId])
  @@index([categoryId])
  @@map("channel_categories")
}

// One row per "Atualizar agora" execution per channel — gives us the
// historical series we need for the analytics charts (subscriber growth,
// total views growth, video count over time).
model ChannelSnapshot {
  id              String   @id @default(uuid())
  channelId       String   @map("channel_id")
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  takenAt         DateTime @default(now()) @map("taken_at")
  subscriberCount BigInt?  @map("subscriber_count")
  totalViewCount  BigInt?  @map("total_view_count")
  videoCount      Int?     @map("video_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([channelId, takenAt])
  @@map("channel_snapshots")
}

model Video {
  id           String   @id @default(uuid())
  youtubeId    String   @unique @map("youtube_id")
  channelId    String   @map("channel_id")
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title        String
  thumbnailUrl String?  @map("thumbnail_url")
  // BigInt — vídeos virais ultrapassam 2^31 (Baby Shark ~15B, Despacito 8.5B).
  viewCount    BigInt   @default(0) @map("view_count")
  likeCount    Int?     @map("like_count")
  commentCount Int?     @map("comment_count")
  durationSec  Int?     @map("duration_sec")
  publishedAt  DateTime @map("published_at")

  // Outlier detection — recomputed on every update run.
  channelAvgViewsAtCheck Int?    @map("channel_avg_views_at_check")
  outlierPercent         Float?  @map("outlier_percent")
  flaggedAsOutlier       Boolean @default(false) @map("flagged_as_outlier")

  // Module 2 — extracted on demand via "Extrair informações"
  description         String?
  tags                String?   // JSON-encoded string array
  thumbnailHdUrl      String?   @map("thumbnail_hd_url")
  language            String?
  category            String?
  liveBroadcastStatus String?   @map("live_broadcast_status")
  metadataExtractedAt DateTime? @map("metadata_extracted_at")

  // Module 3 — extracted on demand via "Extrair transcrição"
  transcriptSegments    String?   @map("transcript_segments") // JSON [{ start: number, text: string }]
  transcriptStatus      String?   @map("transcript_status") // 'available' | 'unavailable'
  transcriptLanguage    String?   @map("transcript_language")
  transcriptExtractedAt DateTime? @map("transcript_extracted_at")

  // Biblioteca pessoal — usuário "salva" vídeos pra consulta. Independente
  // do monitoramento (vídeo pode estar na lib mesmo se o canal sai do
  // monitoramento). libraryAddedAt vira a ordem padrão da listagem.
  inLibrary       Boolean   @default(false) @map("in_library")
  libraryAddedAt  DateTime? @map("library_added_at")
  libraryNotes    String?   @map("library_notes")

  snapshots        VideoSnapshot[]
  kanbanReferences KanbanCardReference[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([channelId, publishedAt])
  @@index([flaggedAsOutlier, publishedAt])
  @@index([metadataExtractedAt])
  @@index([inLibrary, libraryAddedAt])
  @@map("videos")
}

// One row per "Atualizar agora" execution per video — gives us the
// historical view-count series for each video, used for the evergreen
// detector (videos that keep gaining views over time) and per-video
// growth charts in v2+.
model VideoSnapshot {
  id           String     @id @default(uuid())
  videoId      String     @map("video_id")
  video        Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // Snapshots created by an "Atualizar agora" carry the run id so the evergreen
  // detector can group snapshots taken in the same update and compute per-update
  // channel averages. Backfill snapshots leave this null (they're a baseline
  // marker, not an interval boundary).
  updateRunId  String?    @map("update_run_id")
  updateRun    UpdateRun? @relation(fields: [updateRunId], references: [id], onDelete: SetNull)
  takenAt      DateTime   @default(now()) @map("taken_at")
  // BigInt — pareia com Video.viewCount.
  viewCount    BigInt     @map("view_count")
  likeCount    Int?       @map("like_count")
  commentCount Int?       @map("comment_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([videoId, takenAt])
  @@index([updateRunId])
  @@map("video_snapshots")
}

// One row per "update all channels" execution.
model UpdateRun {
  id                 String    @id @default(uuid())
  triggeredBy        String    @map("triggered_by") // 'manual' | 'scheduled' | 'startup'
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  status             String    @default("running") // 'running' | 'success' | 'partial' | 'failed'
  channelsTotal      Int       @default(0) @map("channels_total")
  channelsSuccessful Int       @default(0) @map("channels_successful")
  channelsFailed     Int       @default(0) @map("channels_failed")
  videosNew          Int       @default(0) @map("videos_new")
  videosFlagged      Int       @default(0) @map("videos_flagged")
  errorMessage       String?   @map("error_message")

  videoSnapshots VideoSnapshot[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([startedAt])
  @@map("update_runs")
}

// IsiPanel license cache. Singleton in practice — only one active license per
// install. App enforces singleton-ness by upserting the most-recently-validated
// row (queries use findFirst({ deletedAt: null }, orderBy: lastValidatedAt desc)).
//
// `licenseKey` is encrypted with Electron `safeStorage` (DPAPI on Windows).
// `lastResponseJson` caches the full validate response so the renderer can
// fall back to it during the 48h grace_until window without re-validating.
model License {
  id               String   @id @default(uuid())
  licenseKey       Bytes    @map("license_key") // safeStorage-encrypted
  hwid             String
  slug             String // 'isitube' | 'isitubepro'
  plan             String // 'iniciante' | 'pro'
  expiresAt        DateTime? @map("expires_at")
  graceUntil       DateTime? @map("grace_until")
  subscriptionUrl  String?   @map("subscription_url")
  supportUrl       String?   @map("support_url")
  lastValidatedAt  DateTime  @map("last_validated_at")
  lastResponseJson String    @map("last_response_json")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("licenses")
}

// Active scheduled update. Only one is "active" at a time — setting a new
// schedule cancels the previous.
model ScheduledUpdate {
  id          String    @id @default(uuid())
  scheduledAt DateTime  @map("scheduled_at")
  active      Boolean   @default(true)
  cancelled   Boolean   @default(false)
  ranAt       DateTime? @map("ran_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([active, scheduledAt])
  @@map("scheduled_updates")
}

// =============================================================================
// Kanban (Module 6) — board único de planejamento de vídeos.
//
// Modelo: N colunas ordenadas → N cards ordenados por coluna. Card carrega
// título, palavra-chave principal (com link opcional pra análise cacheada),
// secundárias, roteiro, N thumbnails (uma marcada como cover) e referências
// linkadas a vídeos da biblioteca (cada uma tipada como 'thumb'|'titulo'|
// 'roteiro' pra explicar pra que serve a referência).
// =============================================================================

model KanbanColumn {
  id        String       @id @default(uuid())
  name      String
  position  Int
  collapsed Boolean      @default(false)
  cards     KanbanCard[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([position])
  @@map("kanban_columns")
}

model KanbanCard {
  id                String       @id @default(uuid())
  columnId          String       @map("column_id")
  column            KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  position          Int
  title             String       @default("")
  // Palavra-chave principal — texto livre. Quando bate com uma Keyword
  // já analisada, linkedKeywordId aponta pra ela pra dar atalho à análise.
  mainKeyword       String?      @map("main_keyword")
  linkedKeywordId   String?      @map("linked_keyword_id")
  linkedKeyword     Keyword?     @relation(fields: [linkedKeywordId], references: [id], onDelete: SetNull)
  secondaryKeywords String?      @map("secondary_keywords") // JSON array of strings
  // Campos preenchidos pelos agentes de IA do card (SEO/metadados e roteiro).
  description       String?      // descrição do vídeo (agente SEO)
  tags              String?      // JSON array de strings (agente SEO)
  chapters          String?      // JSON array de { timestamp, label } (agente SEO)
  hashtags          String?      // JSON array de strings (agente SEO)
  hook              String?      // gancho escolhido — parte 1 do roteiro
  thumbnailPrompt   String?      @map("thumbnail_prompt") // brief de thumbnail (do agente de ideação)
  format            String?      // formato do vídeo: 'longo' | 'short' | 'live' | 'estreia'
  script            String?
  // Anotações livres de planejamento do vídeo (o que gravar, com quem, o que
  // comprar/preparar). Diferente de `script`: não é o texto que vai ao ar.
  planning          String?

  thumbnails KanbanCardThumbnail[]
  references KanbanCardReference[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([columnId, position])
  @@index([linkedKeywordId])
  @@map("kanban_cards")
}

model KanbanCardThumbnail {
  id       String     @id @default(uuid())
  cardId   String     @map("card_id")
  card     KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position Int        @default(0)
  // Bytes da imagem + mime type. Tamanhos típicos: 100kB-1MB.
  data     Bytes
  mimeType String     @map("mime_type")
  // Só uma thumbnail por card deve ter isCover=true. Service garante.
  isCover  Boolean    @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([cardId, position])
  @@map("kanban_card_thumbnails")
}

model KanbanCardReference {
  id      String     @id @default(uuid())
  cardId  String     @map("card_id")
  card    KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  videoId String     @map("video_id")
  video   Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // 'thumb' | 'titulo' | 'roteiro' — o mesmo vídeo pode ser linkado várias
  // vezes desde que com tipos diferentes (unique constraint cobre isso).
  refType String     @map("ref_type")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cardId, videoId, refType])
  @@index([videoId])
  @@map("kanban_card_references")
}

// Ideias de vídeo geradas pelo agente de Ideação. Ficam salvas pro criador
// revisitar, apagar ou promover pra card do Kanban. Campos = VideoIdea + contexto.
model GeneratedIdea {
  id               String @id @default(uuid())
  title            String
  trafficStrategy  String @map("traffic_strategy")
  keyword          String
  competition      String
  volumeTier       String @map("volume_tier")
  trendDirection   String @map("trend_direction")
  contentLengthMin Int    @map("content_length_min")
  hookAngle        String @map("hook_angle")
  thumbnailConcept String @map("thumbnail_concept")
  whyThisIdea      String @map("why_this_idea")
  urgency          String
  score            Int
  niche            String?

  createdAt DateTime  @default(now()) @map("created_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([createdAt])
  @@map("generated_ideas")
}

// =============================================================================
// Thumbnail Studio (Module 7) — geração de thumbnails com IA (Gemini).
//
// Assets de referência reusáveis (rosto/cenário/estilo) + histórico de gerações.
// Imagens guardadas como BLOB (mesmo padrão do KanbanCardThumbnail) pra entrarem
// no backup do .db e reusarem o fluxo base64 → BLOB → data URL do renderer.
// =============================================================================

model ThumbnailAsset {
  id       String @id @default(uuid())
  // 'face' (identidade do criador) | 'scene' (fundo/cenário) | 'style' (thumb vencedora de referência)
  kind     String
  label    String
  // Bytes da imagem + mime type. Tamanhos típicos: 100kB-1.5MB (downscale no ingest).
  data     Bytes
  mimeType String @map("mime_type")
  width    Int?
  height   Int?
  // 'upload' (usuário subiu) | 'library' (materializado de um vídeo monitorado)
  sourceType    String  @map("source_type")
  sourceVideoId String? @map("source_video_id")
  // Descrição de estilo gerada por IA (visão), cacheada. Usada como texto na
  // geração — evita mandar a imagem da referência (e a pessoa dela) pro gerador.
  styleDescription String? @map("style_description")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([kind, createdAt])
  @@map("thumbnail_assets")
}

model ThumbnailGeneration {
  id          String @id @default(uuid())
  prompt      String
  // Ids dos ThumbnailAsset usados como referência (JSON array of strings).
  refAssetIds String @map("ref_asset_ids")
  // 'gemini' | 'mock'
  provider    String
  model       String
  aspectRatio String @default("16:9") @map("aspect_ratio")
  // Bytes da imagem gerada + mime type.
  data     Bytes
  mimeType String @map("mime_type")
  // Estimativa de custo em USD dessa geração (null pro mock).
  costEstimateUsd Float? @map("cost_estimate_usd")
  // Personagem/cenário usados (ids soltos, sem FK — sobrevivem à exclusão deles).
  characterId String? @map("character_id")
  sceneId     String? @map("scene_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([createdAt])
  @@map("thumbnail_generations")
}

// Personagem: identidade reusável do criador. Agrupa N fotos (recomendado 5-10)
// pra a IA aprender rosto/corpo. Na geração o usuário seleciona 1 personagem.
model ThumbnailCharacter {
  id     String                    @id @default(uuid())
  name   String
  notes  String?
  photos ThumbnailCharacterPhoto[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("thumbnail_characters")
}

model ThumbnailCharacterPhoto {
  id          String             @id @default(uuid())
  characterId String             @map("character_id")
  character   ThumbnailCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  data        Bytes
  mimeType    String             @map("mime_type")
  width       Int?
  height      Int?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([characterId])
  @@map("thumbnail_character_photos")
}

// Cenário: fundo reusável (foto do set). Uma imagem + nome. Na geração é
// opcional (usuário decide se usa e qual).
model ThumbnailScene {
  id       String @id @default(uuid())
  name     String
  data     Bytes
  mimeType String @map("mime_type")
  width    Int?
  height   Int?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("thumbnail_scenes")
}

// =============================================================================
// Canal próprio (OAuth + YouTube Analytics) — Módulo 8
//
// Singleton na prática (uma conexão por install). client_secret e refresh_token
// ficam criptografados via safeStorage (DPAPI). O app troca o refresh_token por
// access tokens e chama a YouTube Analytics API (retenção/CTR/AVD/receita).
// O client OAuth é do PRÓPRIO projeto Google do usuário (BYOK, plano Pro).
// =============================================================================
model YoutubeConnection {
  id             String    @id @default(uuid())
  clientId       String    @map("client_id")
  clientSecret   Bytes     @map("client_secret") // safeStorage-encrypted
  refreshToken   Bytes?    @map("refresh_token") // safeStorage-encrypted
  scope          String?
  channelId      String?   @map("channel_id")
  channelTitle   String?   @map("channel_title")
  connectedAt    DateTime? @map("connected_at")
  needsReconnect Boolean   @default(false) @map("needs_reconnect")
  lastError      String?   @map("last_error")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("youtube_connections")
}
